<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,org.example.skillsprint.model.CodingProgress" %>
<%! private String esc(Object value) { if(value==null)return ""; return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;"); } %>
<% CodingProgress record=(CodingProgress)request.getAttribute("record"); if(record==null)record=new CodingProgress(); boolean edit=Boolean.TRUE.equals(request.getAttribute("editMode")); String rawDate=(String)request.getAttribute("rawDate"); String date=rawDate!=null?rawDate:(record.getSolvedDate()==null?"":record.getSolvedDate().toString()); String selectedStatus=record.getProblemStatus()==null||record.getProblemStatus().isEmpty()?"Solved":record.getProblemStatus(); request.setAttribute("pageTitle",edit?"Edit coding record":"Add coding record"); request.setAttribute("pageSubtitle","Capture a problem and keep your learning history up to date."); request.setAttribute("activePage","coding"); %>
<%@ include file="_app-header.jspf" %>
<% if(request.getAttribute("error")!=null){ %><div class="alert error" role="alert" data-dismissible><%=esc(request.getAttribute("error"))%><button class="alert-dismiss" type="button" data-dismiss aria-label="Dismiss message">×</button></div><% } %>
<section class="form-card"><form method="post" action="<%=request.getContextPath()%>/coding/<%=edit?"update":"create"%>" data-submitting><input type="hidden" name="_csrf" value="<%=request.getAttribute("csrfToken")%>"><% if(edit){ %><input type="hidden" name="id" value="<%=record.getCodingId()%>"><% } %>
<div class="form-grid"><div class="field"><label for="platform">Platform</label><input id="platform" name="platform" maxlength="50" value="<%=esc(record.getPlatform())%>" placeholder="e.g. LeetCode"></div>
<div class="field"><label for="problemName">Problem name <span class="required-mark">*</span></label><input id="problemName" name="problemName" required maxlength="150" value="<%=esc(record.getProblemName())%>"></div>
<div class="field"><label for="difficulty">Difficulty <span class="required-mark">*</span></label><select id="difficulty" name="difficulty" required><option value="">Choose difficulty</option><% for(String d:(List<String>)request.getAttribute("difficulties")){ %><option value="<%=esc(d)%>" <%=d.equals(record.getDifficulty())?"selected":""%>><%=esc(d)%></option><% } %></select></div>
<div class="field"><label for="problemStatus">Status <span class="required-mark">*</span></label><select id="problemStatus" name="problemStatus" required><% for(String s:(List<String>)request.getAttribute("statuses")){ %><option value="<%=esc(s)%>" <%=s.equals(selectedStatus)?"selected":""%>><%=esc(s)%></option><% } %></select></div>
<div class="field"><label for="solvedDate">Solved date</label><input id="solvedDate" type="date" name="solvedDate" value="<%=esc(date)%>"></div>
<div class="field full"><label for="problemUrl">Problem URL <span class="field-hint">Optional · HTTP or HTTPS</span></label><input id="problemUrl" type="url" name="problemUrl" maxlength="255" value="<%=esc(record.getProblemUrl())%>" placeholder="https://..."></div></div>
<div class="form-actions"><button type="submit"><%=edit?"Save changes":"Add record"%></button><a class="button secondary" href="<%=request.getContextPath()%>/coding/list">Cancel</a></div></form></section>
<%@ include file="_app-footer.jspf" %>
