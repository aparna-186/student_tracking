<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="org.example.skillsprint.model.Certificate" %>
<%! private String esc(Object value) { if(value==null)return ""; return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;"); } %>
<% Certificate certificate=(Certificate)request.getAttribute("certificate"); if(certificate==null)certificate=new Certificate(); boolean edit=Boolean.TRUE.equals(request.getAttribute("editMode")); String rawDate=(String)request.getAttribute("rawDate"); String date=rawDate!=null?rawDate:(certificate.getIssueDate()==null?"":certificate.getIssueDate().toString()); request.setAttribute("pageTitle",edit?"Edit certificate":"Add certificate"); request.setAttribute("pageSubtitle","Save the details that help you remember and share this credential."); request.setAttribute("activePage","certificates"); %>
<%@ include file="_app-header.jspf" %>
<% if(request.getAttribute("error")!=null){ %><div class="alert error" role="alert" data-dismissible><%=esc(request.getAttribute("error"))%><button class="alert-dismiss" type="button" data-dismiss aria-label="Dismiss message">×</button></div><% } %>
<section class="form-card"><form method="post" action="<%=request.getContextPath()%>/certificates/<%=edit?"update":"create"%>" data-submitting><input type="hidden" name="_csrf" value="<%=request.getAttribute("csrfToken")%>"><% if(edit){ %><input type="hidden" name="id" value="<%=certificate.getCertificateId()%>"><% } %>
<div class="form-grid"><div class="field full"><label for="title">Certificate title <span class="required-mark">*</span></label><input id="title" name="title" required maxlength="150" value="<%=esc(certificate.getTitle())%>"></div>
<div class="field"><label for="issuer">Issuer</label><input id="issuer" name="issuer" maxlength="100" value="<%=esc(certificate.getIssuer())%>"></div>
<div class="field"><label for="issueDate">Issue date</label><input id="issueDate" type="date" name="issueDate" value="<%=esc(date)%>"></div>
<div class="field full"><label for="credentialLink">Credential URL <span class="field-hint">Optional · HTTP or HTTPS</span></label><input id="credentialLink" type="url" name="credentialLink" maxlength="500" placeholder="https://..." value="<%=esc(certificate.getCredentialLink())%>"></div></div>
<div class="form-actions"><button type="submit"><%=edit?"Save changes":"Add certificate"%></button><a class="button secondary" href="<%=request.getContextPath()%>/certificates/list">Cancel</a></div></form></section>
<%@ include file="_app-footer.jspf" %>
