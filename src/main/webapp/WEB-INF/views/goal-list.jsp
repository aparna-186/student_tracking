<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,org.example.skillsprint.model.Goal" %>
<%! private String esc(Object value) { if(value==null)return ""; return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;"); } %>
<% request.setAttribute("pageTitle","Learning Goals"); request.setAttribute("pageSubtitle","Make room for the milestones that matter to you."); request.setAttribute("activePage","goals"); request.setAttribute("pageActionLabel","Add goal"); request.setAttribute("pageActionUrl","/goals/new"); String selected=String.valueOf(request.getAttribute("selectedStatus")); %>
<%@ include file="_app-header.jspf" %>
<form class="filters" method="get" action="<%=request.getContextPath()%>/goals/list"><div class="field"><label for="goalStatus">Status</label><select id="goalStatus" name="status"><option value="" <%=selected.equals("")?"selected":""%>>All goals</option><option value="Pending" <%=selected.equals("Pending")?"selected":""%>>Pending</option><option value="Completed" <%=selected.equals("Completed")?"selected":""%>>Completed</option></select></div><button type="submit">Apply filter</button><a class="button secondary" href="<%=request.getContextPath()%>/goals/list">Clear</a></form>
<% List<Goal> goals=(List<Goal>)request.getAttribute("goals"); if(goals==null||goals.isEmpty()){ %><section class="empty-state"><h2>No goals found</h2><p>Add a goal to make your next learning milestone concrete, or clear the status filter.</p><a class="button" href="<%=request.getContextPath()%>/goals/new">Add goal</a></section>
<% }else{ %><div class="table-wrap"><table><thead><tr><th>Goal</th><th>Deadline</th><th>Status</th><th>Actions</th></tr></thead><tbody><% for(Goal goal:goals){ boolean completed="Completed".equals(goal.getStatus()); %><tr><td><strong><%=esc(goal.getGoalTitle())%></strong></td><td><%=esc(goal.getDeadline())%></td><td><span class="badge <%=completed?"success":"warning"%>"><%=esc(goal.getStatus())%></span></td><td><div class="table-actions"><a class="button secondary" href="<%=request.getContextPath()%>/goals/edit?id=<%=goal.getGoalId()%>">Edit</a><% if(!completed){ %><form method="post" action="<%=request.getContextPath()%>/goals/complete"><input type="hidden" name="_csrf" value="<%=request.getAttribute("csrfToken")%>"><input type="hidden" name="id" value="<%=goal.getGoalId()%>"><button type="submit">Mark completed</button></form><% } %><form method="post" action="<%=request.getContextPath()%>/goals/delete" data-confirm="Delete this goal?"><input type="hidden" name="_csrf" value="<%=request.getAttribute("csrfToken")%>"><input type="hidden" name="id" value="<%=goal.getGoalId()%>"><button class="danger" type="submit">Delete</button></form></div></td></tr><% } %></tbody></table></div><% } %>
<%@ include file="_app-footer.jspf" %>
