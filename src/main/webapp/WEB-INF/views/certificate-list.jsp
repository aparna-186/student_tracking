<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.net.URI,java.net.URISyntaxException,java.time.format.DateTimeFormatter,java.util.List,java.util.Locale,org.example.skillsprint.model.Certificate" %>
<%! private String esc(Object value) { if(value==null)return ""; return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;"); }
private boolean safeUrl(String value) { try { URI uri=new URI(value); String scheme=uri.getScheme(); return scheme!=null&&(scheme.equalsIgnoreCase("http")||scheme.equalsIgnoreCase("https"))&&uri.getHost()!=null&&!uri.getHost().isEmpty(); } catch(URISyntaxException e){return false;} }
private String displayDate(java.sql.Date date) { return date==null?"—":date.toLocalDate().format(DateTimeFormatter.ofPattern("MMM d, uuuu",Locale.ENGLISH)); } %>
<% request.setAttribute("pageTitle","Certificates"); request.setAttribute("pageSubtitle","Keep your earned credentials organized and ready to share."); request.setAttribute("activePage","certificates"); request.setAttribute("pageActionLabel","Add certificate"); request.setAttribute("pageActionUrl","/certificates/new"); %>
<%@ include file="_app-header.jspf" %>
<% List<Certificate> certificates=(List<Certificate>)request.getAttribute("certificates"); if(certificates==null||certificates.isEmpty()){ %><section class="empty-state"><h2>No certificates yet</h2><p>Add a certificate and its credential link to keep your achievements together.</p><a class="button" href="<%=request.getContextPath()%>/certificates/new">Add certificate</a></section>
<% }else{ %><div class="table-wrap"><table><thead><tr><th>Certificate</th><th>Issuer</th><th>Issue date</th><th>Credential</th><th>Actions</th></tr></thead><tbody><% for(Certificate certificate:certificates){ String url=certificate.getCredentialLink(); %><tr><td><strong><%=esc(certificate.getTitle())%></strong></td><td><%=esc(certificate.getIssuer())%></td><td><%=displayDate(certificate.getIssueDate())%></td><td><% if(url==null||url.isEmpty()){ %><span class="field-hint">No credential link provided</span><% }else if(safeUrl(url)){ %><a href="<%=esc(url)%>" target="_blank" rel="noopener noreferrer">View certificate</a><% }else{ %><span class="field-hint">No credential link provided</span><% } %></td><td><div class="table-actions"><a class="button secondary" href="<%=request.getContextPath()%>/certificates/edit?id=<%=certificate.getCertificateId()%>">Edit</a><form method="post" action="<%=request.getContextPath()%>/certificates/delete" data-confirm="Delete this certificate?"><input type="hidden" name="_csrf" value="<%=request.getAttribute("csrfToken")%>"><input type="hidden" name="id" value="<%=certificate.getCertificateId()%>"><button class="danger" type="submit">Delete</button></form></div></td></tr><% } %></tbody></table></div><% } %>
<%@ include file="_app-footer.jspf" %>
