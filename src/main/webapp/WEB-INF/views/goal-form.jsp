<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,org.example.skillsprint.model.Goal" %>
<%! private String esc(Object value) { if(value==null)return ""; return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;"); } %>
<% Goal goal=(Goal)request.getAttribute("goal"); if(goal==null)goal=new Goal(); boolean edit=Boolean.TRUE.equals(request.getAttribute("editMode")); String rawDeadline=(String)request.getAttribute("rawDeadline"); String deadline=rawDeadline!=null?rawDeadline:(goal.getDeadline()==null?"":goal.getDeadline().toString()); String selectedStatus=goal.getStatus()==null||goal.getStatus().isEmpty()?"Pending":goal.getStatus(); request.setAttribute("pageTitle",edit?"Edit goal":"Add a learning goal"); request.setAttribute("pageSubtitle","Choose a milestone and a deadline that feels achievable."); request.setAttribute("activePage","goals"); %>
<%@ include file="_app-header.jspf" %>
<% if(request.getAttribute("error")!=null){ %><div class="alert error" role="alert" data-dismissible><%=esc(request.getAttribute("error"))%><button class="alert-dismiss" type="button" data-dismiss aria-label="Dismiss message">×</button></div><% } %>
<section class="form-card"><form method="post" action="<%=request.getContextPath()%>/goals/<%=edit?"update":"create"%>" data-submitting><input type="hidden" name="_csrf" value="<%=request.getAttribute("csrfToken")%>"><% if(edit){ %><input type="hidden" name="id" value="<%=goal.getGoalId()%>"><% } %>
<div class="form-grid"><div class="field full"><label for="goalTitle">Goal title <span class="required-mark">*</span></label><input id="goalTitle" name="goalTitle" required maxlength="200" value="<%=esc(goal.getGoalTitle())%>" placeholder="e.g. Complete Java Collections"></div>
<div class="field"><label for="deadline">Deadline <span class="field-hint">Optional</span></label><input id="deadline" type="date" name="deadline" value="<%=esc(deadline)%>"></div>
<div class="field"><label for="goalStatus">Status <span class="required-mark">*</span></label><select id="goalStatus" name="status" required><% for(String status:(List<String>)request.getAttribute("statuses")){ %><option value="<%=esc(status)%>" <%=status.equals(selectedStatus)?"selected":""%>><%=esc(status)%></option><% } %></select></div></div>
<div class="form-actions"><button type="submit"><%=edit?"Save changes":"Add goal"%></button><a class="button secondary" href="<%=request.getContextPath()%>/goals/list">Cancel</a></div></form></section>
<%@ include file="_app-footer.jspf" %>
