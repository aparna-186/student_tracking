<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,java.net.URI,java.net.URISyntaxException,org.example.skillsprint.model.CodingProgress" %>
<%! private String esc(Object value) { if(value==null)return ""; return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;"); }
private boolean safeUrl(String value) { try { URI u=new URI(value); String s=u.getScheme(); return s!=null&&(s.equalsIgnoreCase("http")||s.equalsIgnoreCase("https"))&&u.getHost()!=null; } catch(URISyntaxException e){return false;} }
private String statusBadge(String value) { return "Solved".equals(value)?"success":"Attempted".equals(value)?"warning":"danger"; }
private String difficultyBadge(String value) { return "Easy".equals(value)?"success":"Hard".equals(value)?"danger":"warning"; } %>
<% request.setAttribute("pageTitle","Coding Progress"); request.setAttribute("pageSubtitle","Keep your practice sessions visible and moving forward."); request.setAttribute("activePage","coding"); request.setAttribute("pageActionLabel","Add coding record"); request.setAttribute("pageActionUrl","/coding/new"); %>
<%@ include file="_app-header.jspf" %>
<form class="filters" method="get" action="<%=request.getContextPath()%>/coding/list">
<div class="field"><label for="platform">Platform</label><input id="platform" name="platform" maxlength="50" placeholder="e.g. LeetCode" value="<%=esc(request.getParameter("platform"))%>"></div>
<div class="field"><label for="difficulty">Difficulty</label><select id="difficulty" name="difficulty"><option value="">All difficulties</option><% for(String d:(List<String>)request.getAttribute("difficulties")){ %><option value="<%=esc(d)%>" <%=d.equals(request.getParameter("difficulty"))?"selected":""%>><%=esc(d)%></option><% } %></select></div>
<div class="field"><label for="status">Status</label><select id="status" name="status"><option value="">All statuses</option><% for(String s:(List<String>)request.getAttribute("statuses")){ %><option value="<%=esc(s)%>" <%=s.equals(request.getParameter("status"))?"selected":""%>><%=esc(s)%></option><% } %></select></div>
<button type="submit">Apply filters</button><a class="button secondary" href="<%=request.getContextPath()%>/coding/list">Clear</a></form>
<% List<CodingProgress> records=(List<CodingProgress>)request.getAttribute("records"); if(records==null||records.isEmpty()){ %><section class="empty-state"><h2>No coding records found</h2><p>Record a solved or attempted problem to keep your practice history in one place.</p><a class="button" href="<%=request.getContextPath()%>/coding/new">Add coding record</a></section>
<% }else{ %><div class="table-wrap"><table><thead><tr><th>Platform</th><th>Problem</th><th>Difficulty</th><th>Status</th><th>Solved date</th><th>Problem URL</th><th>Actions</th></tr></thead><tbody>
<% for(CodingProgress r:records){ String url=r.getProblemUrl(); %><tr><td><%=esc(r.getPlatform())%></td><td><strong><%=esc(r.getProblemName())%></strong></td><td><span class="badge <%=difficultyBadge(r.getDifficulty())%>"><%=esc(r.getDifficulty())%></span></td><td><span class="badge <%=statusBadge(r.getProblemStatus())%>"><%=esc(r.getProblemStatus())%></span></td><td><%=esc(r.getSolvedDate())%></td><td><% if(url!=null&&!url.isEmpty()&&safeUrl(url)){ %><a href="<%=esc(url)%>" target="_blank" rel="noopener noreferrer">Open problem</a><% }else if(url!=null&&!url.isEmpty()){ %><%=esc(url)%><% }else{ %>—<% } %></td><td><div class="table-actions"><a class="button secondary" href="<%=request.getContextPath()%>/coding/edit?id=<%=r.getCodingId()%>">Edit</a><form method="post" action="<%=request.getContextPath()%>/coding/delete" data-confirm="Delete this coding record?"><input type="hidden" name="_csrf" value="<%=request.getAttribute("csrfToken")%>"><input type="hidden" name="id" value="<%=r.getCodingId()%>"><button class="danger" type="submit">Delete</button></form></div></td></tr><% } %>
</tbody></table></div><% } %>
<%@ include file="_app-footer.jspf" %>
