<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>SkillSprint</display-name>

    <!-- Preserve filter order: authentication first, then CSRF validation. -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>org.example.skillsprint.filter.AuthFilter</filter-class>
    </filter>
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>org.example.skillsprint.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/dashboard</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/applications/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/coding/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/certificates/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/goals/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/profile</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/session-test</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/dashboard</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/applications/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/coding/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/certificates/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/goals/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/profile</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/session-test</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/logout</url-pattern></filter-mapping>

    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextClass</param-name>
            <param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
        </init-param>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>org.example.skillsprint.config.WebConfig</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>
    <request-character-encoding>UTF-8</request-character-encoding>
</web-app>
